#!/usr/bin/env bash
#
# clipssh - Send clipboard screenshot to remote SSH host
# https://github.com/samuellawrentz/clipssh
#

set -e

VERSION="1.0.0"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

ALIAS_DIR="$HOME/.clipssh"
ALIAS_FILE="$ALIAS_DIR/aliases"

usage() {
    echo "Usage: clipssh [user@host|alias] [options]"
    echo "       clipssh alias add <name> <user@host>"
    echo "       clipssh alias remove <name>"
    echo "       clipssh alias list"
    echo ""
    echo "Send clipboard screenshot to remote SSH host and copy path to clipboard."
    echo ""
    echo "Arguments:"
    echo "  user@host    Remote host (default: \$CLIPSSH_HOST)"
    echo "  alias        Saved alias name (resolved from ~/.clipssh/aliases,"
    echo "               falling back to Host entries in ~/.ssh/config)"
    echo ""
    echo "Subcommands:"
    echo "  alias add <name> <user@host>  Save a host under a short name"
    echo "  alias remove <name>           Delete a saved alias"
    echo "  alias list                    Show all saved aliases"
    echo ""
    echo "Options:"
    echo "  -h, --help     Show this help"
    echo "  -v, --version  Show version"
    echo ""
    echo "Environment:"
    echo "  CLIPSSH_HOST         Default remote host"
    echo "  CLIPSSH_REMOTE_DIR   Remote directory for uploads (default: /tmp)"
    echo ""
    echo "Example:"
    echo "  clipssh alias add myserver user@myserver.com"
    echo "  clipssh myserver"
    echo "  clipssh user@myserver"
    echo "  CLIPSSH_HOST=user@server clipssh"
}

error() {
    echo -e "${RED}Error:${NC} $1" >&2
    exit 1
}

success() {
    echo -e "${GREEN}$1${NC}"
}

ensure_alias_file() {
    mkdir -p "$ALIAS_DIR"
    [[ -f "$ALIAS_FILE" ]] || touch "$ALIAS_FILE"
}

alias_add() {
    local name="$1"
    local target="$2"
    [[ -z "$name" || -z "$target" ]] && error "Usage: clipssh alias add <name> <user@host>"
    [[ "$name" == *"="* || "$name" == *" "* ]] && error "Invalid alias name: $name"
    [[ "$target" != *"@"* ]] && error "Target must be in user@host form: $target"
    ensure_alias_file
    local tmp
    tmp=$(mktemp)
    grep -v "^${name}=" "$ALIAS_FILE" > "$tmp" 2>/dev/null || true
    mv "$tmp" "$ALIAS_FILE"
    echo "${name}=${target}" >> "$ALIAS_FILE"
    success "Saved alias: ${name} -> ${target}"
}

alias_remove() {
    local name="$1"
    [[ -z "$name" ]] && error "Usage: clipssh alias remove <name>"
    ensure_alias_file
    if ! grep -q "^${name}=" "$ALIAS_FILE" 2>/dev/null; then
        error "Alias not found: $name"
    fi
    local tmp
    tmp=$(mktemp)
    grep -v "^${name}=" "$ALIAS_FILE" > "$tmp" || true
    mv "$tmp" "$ALIAS_FILE"
    success "Removed alias: $name"
}

alias_list() {
    ensure_alias_file
    if [[ ! -s "$ALIAS_FILE" ]]; then
        echo "No aliases saved. Add one with: clipssh alias add <name> <user@host>"
        return
    fi
    cat "$ALIAS_FILE"
}

resolve_alias() {
    local name="$1"
    local match=""
    if [[ -f "$ALIAS_FILE" ]]; then
        match=$(grep "^${name}=" "$ALIAS_FILE" | head -n1 || true)
    fi
    # No saved alias? Fall back to the bare name so ssh can resolve it from
    # ~/.ssh/config, which already knows the user, port and identity file.
    if [[ -z "$match" ]]; then
        echo "$name"
    else
        echo "${match#*=}"
    fi
}

# Handle alias subcommand
if [[ "$1" == "alias" ]]; then
    shift
    sub="${1:-}"
    case "$sub" in
        add)    shift; alias_add "$@"; exit 0 ;;
        remove) shift; alias_remove "$@"; exit 0 ;;
        list)   alias_list; exit 0 ;;
        "")     error "Usage: clipssh alias <add|remove|list> ..." ;;
        *)      error "Unknown alias subcommand: $sub" ;;
    esac
fi

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            echo "clipssh $VERSION"
            exit 0
            ;;
        -*)
            error "Unknown option: $1"
            ;;
        *)
            HOST="$1"
            shift
            ;;
    esac
done

# Determine host
HOST="${HOST:-$CLIPSSH_HOST}"
if [[ -z "$HOST" ]]; then
    error "No host specified. Use: clipssh user@host or set CLIPSSH_HOST"
fi

# Resolve alias if HOST is a bare name (no user@)
if [[ "$HOST" != *"@"* ]]; then
    HOST=$(resolve_alias "$HOST")
fi

# Extract port if specified in user@host:port format
SSH_PORT=""
if [[ "$HOST" =~ ^(.*):([0-9]+)$ && "${BASH_REMATCH[1]}" != *:* ]]; then
    HOST="${BASH_REMATCH[1]}"
    SSH_PORT="${BASH_REMATCH[2]}"
fi

# Check OS and clipboard tool
if [[ "$OSTYPE" == "darwin"* ]]; then
    if ! command -v pngpaste &> /dev/null; then
        error "pngpaste not found. Install with: brew install pngpaste"
    fi
    PASTE_CMD="pngpaste"
elif [[ "$OSTYPE" == "linux"* ]]; then
    if [[ -n "$WAYLAND_DISPLAY" ]] && command -v wl-paste &> /dev/null; then
        PASTE_CMD="wl-paste --type image/png"
    elif command -v xclip &> /dev/null; then
        PASTE_CMD="xclip -selection clipboard -target image/png -o"
    else
        error "No clipboard tool found. Install xclip or wl-clipboard"
    fi
else
    error "Unsupported OS: $OSTYPE"
fi

# Keep the local temporary image and its container together for cleanup.
TEMP_DIR=$(mktemp -d)
TEMP_FILE="$TEMP_DIR/image.png"
cleanup_local() { rm -f "$TEMP_FILE"; rmdir "$TEMP_DIR" 2>/dev/null || true; }
trap cleanup_local EXIT

# Extract image from clipboard
if [[ "$OSTYPE" == "darwin"* ]]; then
    if ! pngpaste "$TEMP_FILE" 2>/dev/null; then
        error "No image in clipboard. Take a screenshot first (Cmd+Shift+Ctrl+4)"
    fi
else
    if ! $PASTE_CMD > "$TEMP_FILE" 2>/dev/null; then
        error "No image in clipboard. Take a screenshot first"
    fi
fi

# Verify file has content
if [[ ! -s "$TEMP_FILE" ]]; then
    error "Clipboard image is empty"
fi

# The remote directory must exist; use a per-upload private directory so two
# uploads in the same second cannot overwrite one another.
REMOTE_DIR="${CLIPSSH_REMOTE_DIR:-/tmp}"
case "$REMOTE_DIR" in *$'\n'*|*$'\r'*) error "Remote directory cannot contain a newline" ;; esac
case "$REMOTE_DIR" in /*) ;; *) REMOTE_DIR="./$REMOTE_DIR" ;; esac
REMOTE_DIR="${REMOTE_DIR%/}"
[[ -n "$REMOTE_DIR" ]] || REMOTE_DIR="/"
if [[ "$REMOTE_DIR" == "/" ]]; then REMOTE_DIR=""; fi
# ssh passes a command through a remote shell, so quote directory bytes as one
# POSIX shell word instead of interpreting spaces or shell metacharacters.
REMOTE_QUOTED=${REMOTE_DIR//\'/\'\\\'\'}

# Prepare SSH options
SSH_OPTS=()
if [[ -n "$SSH_PORT" ]]; then
    SSH_OPTS+=("-p" "$SSH_PORT")
fi

# Disable RemoteCommand/TTY so ForceCommand / RequestTTY in ssh_config cannot
# hijack the upload. RemoteCommand requires OpenSSH 7.6+.
SSH_VER=$(ssh -V 2>&1)
if [[ "$SSH_VER" =~ OpenSSH_([0-9]+)\.([0-9]+) ]]; then
    SSH_MAJOR="${BASH_REMATCH[1]}"
    SSH_MINOR="${BASH_REMATCH[2]}"
    if (( SSH_MAJOR > 7 || (SSH_MAJOR == 7 && SSH_MINOR >= 6) )); then
        SSH_OPTS+=("-o" "RemoteCommand=none")
    fi
fi
SSH_OPTS+=("-o" "RequestTTY=no" "-T")

# Allocate and write in one SSH session. mktemp -d atomically reserves a
# private directory on GNU and BSD systems; its trailing Xs are required by BSD.
# If the data stream fails, remove only the file and directory just created.
REMOTE_CMD="dir='$REMOTE_QUOTED'; umask 077; upload_dir=\$(mktemp -d \"\$dir/clipboard-XXXXXXXX\") || exit 1; upload_file=\"\$upload_dir/image.png\"; if ! cat > \"\$upload_file\"; then rm -f \"\$upload_file\"; rmdir \"\$upload_dir\" 2>/dev/null; exit 1; fi; printf '%s\\n' \"\$upload_file\""
if ! REMOTE_PATH=$(ssh "${SSH_OPTS[@]}" "$HOST" "$REMOTE_CMD" < "$TEMP_FILE" 2>/dev/null); then
    error "Failed to upload to $HOST; the remote outcome may be unknown"
fi
# Do not put unexpected SSH output (for example a login banner) into the
# clipboard as if it were the returned path.
case "$REMOTE_PATH" in
    "$REMOTE_DIR"/clipboard-*) REMOTE_SUFFIX="${REMOTE_PATH#"$REMOTE_DIR"/clipboard-}" ;;
    *) error "Unexpected remote response; the upload outcome is unknown" ;;
esac
[[ "$REMOTE_SUFFIX" =~ ^[[:alnum:]]{8}/image\.png$ ]] || error "Unexpected remote response; the upload outcome is unknown"

# Copy path to clipboard
if [[ "$OSTYPE" == "darwin"* ]]; then
    echo -n "$REMOTE_PATH" | pbcopy
elif [[ -n "$WAYLAND_DISPLAY" ]] && command -v wl-copy &> /dev/null; then
    echo -n "$REMOTE_PATH" | wl-copy
elif command -v xclip &> /dev/null; then
    echo -n "$REMOTE_PATH" | xclip -selection clipboard
fi

success "Uploaded: $REMOTE_PATH"
echo "Path copied to clipboard - paste it directly"
